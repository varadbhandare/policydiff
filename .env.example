# PolicyDiff Environment Variables Example
APP_NAME="PolicyDiff — Semantic Policy Change Detector"
APP_VERSION="1.0.0"
API_PREFIX="/api"
DATABASE_URL="sqlite:///backend/data/db/policydiff.db"
MAX_UPLOAD_SIZE_MB=15
SEMANTIC_SIMILARITY_THRESHOLD_UNCHANGED=0.93
SEMANTIC_SIMILARITY_THRESHOLD_MODIFIED=0.52
LEXICAL_WEIGHT=0.35
SEMANTIC_WEIGHT=0.65
